# ROADSIDE SCENERY - rest stop + rocks
# ---------------------------------------------------------------
SimpleBuilding {
  translation 1000 -40 0
  name "rest_stop"
  floorNumber 1
  corners [ 8 6, 8 -6, -8 -6, -8 6 ]
  wallType "classic building"
  roofShape "flat roof"
}
Rock {
  translation 330 -9 0
  name "rock_01"
  scale 1.5
}
Rock {
  translation 880 31 0
  name "rock_02"
  type "flat"
