WorldInfo {
  title "RoadWatch"
  basicTimeStep 8
  gpsCoordinateSystem "local"
}
Viewpoint {
  orientation 0 1 0 1.5708
  position 450 20 25
  follow "drone_1"
}
TexturedBackground {
  texture "noon_cloudy_countryside"
}
TexturedBackgroundLight {
  texture "noon_cloudy_countryside"
  castShadows FALSE
}
Floor {
  translation 750 0 -0.02
  size 1700 300
  tileSize 20 20
  appearance Grass {
  }
}

# ---------------------------------------------------------------
# ROAD (+ crash barriers on both sides = highway look)
# road center: y=0 for x 0-300 and 1200-1500, y=40 for x 600-900
# ---------------------------------------------------------------
Road {
  translation 0 0 0.01
  width 8
  rightBorder FALSE
  leftBorder FALSE
  rightBarrier TRUE
  leftBarrier TRUE
  wayPoints [
    0 0 0
    300 0 0
    600 40 0
    900 40 0
    1200 0 0
    1500 0 0
  ]
  splineSubdivision 8
}

