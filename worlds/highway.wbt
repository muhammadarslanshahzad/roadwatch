# ---------------------------------------------------------------
# FOREST PATCHES - background only, ~50+ m from road
# low density keeps the FPS alive
# ---------------------------------------------------------------
Forest {
  translation 400 -70 0
  shape [ -60 -20, 60 -20, 60 20, -60 20 ]
  density 0.03
  type "random"
  randomSeed 1
  groundTexture []
  maxHeight 10
  minHeight 5
}
Forest {
  translation 1100 100 0
  shape [ -50 -20, 50 -20, 50 20, -50 20 ]
  density 0.03
  type "random"
  randomSeed 2
  groundTexture []
  maxHeight 10
  minHeight 5
}

